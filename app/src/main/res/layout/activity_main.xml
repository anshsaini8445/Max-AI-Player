<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F0F0F">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Max AI Player"
            app:titleTextColor="#00FFCC"
            android:background="#0F0F0F" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appbar"
        android:layout_above="@id/bottom_nav">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/audio_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/search_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1A1A1A"
                android:hint="Search media..."
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:maxLines="1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/settings_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#0F0F0F"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_hardware"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hardware Acceleration"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="#1A1A1A"
                    android:layout_marginBottom="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dark Theme"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="#1A1A1A"
                    android:layout_marginBottom="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Background Play"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="#1A1A1A"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>
        </ScrollView>

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#000000" />

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1A1A1A"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>