<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/player_bg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Max AI Player"
            app:titleTextColor="@color/neon_accent"
            android:background="@color/player_bg" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appbar"
        android:layout_above="@id/bottom_container">

        <!-- Video Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:visibility="visible" />

        <!-- Audio Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/audio_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- Beats Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/beats_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- Search Layout -->
        <LinearLayout
            android:id="@+id/search_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/player_card_bg"
                android:hint="Search music, videos, beats..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- Settings Layout -->
        <include
            android:id="@+id/settings_layout"
            layout="@layout/layout_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Full Player Layout -->
        <include
            android:id="@+id/full_player_layout"
            layout="@layout/layout_player_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Mini Player (Above Bottom Container) -->
    <include
        android:id="@+id/mini_player_layout"
        layout="@layout/layout_player_mini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_container" />

    <!-- Bottom Container (Search Bar + Bottom Nav) -->
    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/player_card_bg">

        <!-- Search Bar at Bottom -->
        <include
            android:id="@+id/search_bar_layout"
            layout="@layout/layout_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/player_card_bg"
            app:itemIconTint="@color/neon_accent"
            app:itemTextColor="@color/text_primary"
            app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>

</RelativeLayout>
